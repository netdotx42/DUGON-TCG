# Throwaway TESTNET deployer key only. Never use a key that holds mainnet funds.
DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=
CARD_METADATA_BASE_URI=https://your-app.vercel.app/metadata/
# Optional: owner address (defaults to deployer)
CONTRACT_OWNER=

# --- DUGON DAO ($DUGON) ERC-20 wallets (public addresses, not keys) ---
# Empty values fall back to the deployer address. Shares live in scripts/token-config.ts.
DUGON_INITIAL_WALLET=
DUGON_DEV_WALLET=
DUGON_MARKETING_WALLET=
DUGON_PRESALE_WALLET=
DUGON_LP_WALLET=        # 25% for the liquidity pool
