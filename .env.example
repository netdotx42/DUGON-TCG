# ---- Web app (.env.local or Vercel project env) ----

# REQUIRED in production: 32+ random chars. Seals battle state and signs wallet challenges.
#   openssl rand -hex 32
GAME_SECRET=

# Optional. Set after deploying the contract to enable REAL Base Sepolia minting.
# Leave empty to run Base claims in clearly labelled simulated mode.
NEXT_PUBLIC_DUGON_CONTRACT_ADDRESS=

# Optional RPC overrides (public endpoints are used by default)
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Contract deployment variables live in contracts/.env (see contracts/.env.example)
